{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "index.node.ts",
    "server/**/*.ts",
    "api/ApplicationRuleApi.ts",
    "api/FileApi.ts",
    "api/GlobalConfigApi.ts",
    "api/RenamerApi.ts",
    "api/types.ts",
    "dao/**/*.ts",
    "entity/**/*.ts",
    "i18n/nodeI18n.ts",
    "media/**/*.ts",
    "service/**/*.ts",
    "util/ErrorHelper.ts",
    "util/MediaUtil.ts",
    "util/MigrationManager.ts",
    "util/TranslateUtil.ts",
    "util/TranslateWord.ts",
    "util/ValUtil.ts",
    "test/**/*.ts"
  ]
}
