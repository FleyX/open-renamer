{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": false,
    "strictNullChecks": false
  },
  "nodeModulesDir": "auto",
  "imports": {
    "oak": "https://deno.land/x/oak@v12.6.1/mod.ts",
    "oak/router": "https://deno.land/x/oak@v12.6.1/router.ts",
    "oak/body": "https://deno.land/x/oak@v12.6.1/body.ts",
    "oak/send": "https://deno.land/x/oak@v12.6.1/send.ts",
    "deno-sqlite": "https://deno.land/x/sqlite@v3.7.0/mod.ts",
    "log4js": "npm:log4js@^6.4.0",
    "std/": "https://deno.land/std@0.201.0/",
    "uuid": "https://deno.land/std@0.201.0/uuid/mod.ts",
    "axios": "npm:axios@^1.6.0",
    "yaml": "https://deno.land/std@0.201.0/yaml/mod.ts"
  },
  "tasks": {
    "start": "deno run --allow-all --watch index.ts",
    "dev": "deno run --allow-all index.ts",
    "build:mac-arm": "deno compile --target aarch64-apple-darwin --allow-all --output desktop/mac-arm/renamer-mac index.ts",
    "build:mac-x64": "deno compile --target x86_64-apple-darwin --allow-all --output desktop/mac-x64/renamer-mac index.ts",
    "build:win-x64": "deno compile --target x86_64-pc-windows-msvc --allow-all --output desktop/win-x64/renamer-win index.ts",
    "build:linux-arm": "deno compile --target aarch64-unknown-linux-gnu --allow-all --output desktop/linux-arm/renamer-linux index.ts",
    "build:linux-x64": "deno compile --target x86_64-unknown-linux-gnu --allow-all --output desktop/linux-x64/renamer-linux index.ts"
  },
  "permissions": {
    "read": true,
    "write": true,
    "net": true,
    "run": true,
    "env": true
  }
}